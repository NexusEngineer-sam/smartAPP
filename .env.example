# Supabase PostgreSQL
# Supabase Dashboard -> Project -> Connect -> Session pooler (port 5432)
# Replace every placeholder locally. Never commit your real .env file.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:5432/postgres"

# Prisma CLI connection. Use Supabase Session pooler (port 5432) here too,
# or the direct database host if your network supports IPv6.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:5432/postgres"

# Used by the scheduled timetable reminder endpoint. Keep this secret.
CRON_SECRET="replace-with-a-long-random-secret"

# Initial administrator (run npm run db:seed once after configuring the database)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Optional Android/browser push notifications (generate with: npx web-push generate-vapid-keys)
# Keep VAPID_PRIVATE_KEY secret. NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose in the browser.
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-the-same-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LECTURER
  CLASS_REP
  ADMIN
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  avatarUrl    String?      @db.Text
  passwordHash String
  role         UserRole     @default(STUDENT)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  expenses     Expense[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  eventRecipients EventRecipient[]
  auditEntries AuditLog[]  @relation("AuditActor")
  identityTokens IdentityToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  category  String
  amount    Int
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model TimetableEvent {
  id          String   @id @default(cuid())
  title       String
  courseCode  String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  reminderMins Int     @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  notifications Notification[]
  recipients EventRecipient[]
  @@index([startsAt, isActive])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([published, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  eventId     String?
  title       String
  body        String
  channel     String   @default("IN_APP")
  status      String   @default("QUEUED")
  dedupeKey   String   @unique
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       TimetableEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model EventRecipient {
  id        String @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     TimetableEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([userId, eventId])
  @@index([eventId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model IdentityToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

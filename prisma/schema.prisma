generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LECTURER
  CLASS_REP
  ADMIN
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  avatarUrl    String?      @db.Text
  passwordHash String
  role         UserRole     @default(STUDENT)
  isActive     Boolean      @default(true)
  classGroupId String?
  university   String?
  faculty      String?
  course       String?
  profileCompleted Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  expenses     Expense[]
  studentLifeItems StudentLifeItem[]
  personalSchedules PersonalSchedule[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  eventRecipients EventRecipient[]
  auditEntries AuditLog[]  @relation("AuditActor")
  identityTokens IdentityToken[]
  passwordResetTokens PasswordResetToken[]
  classGroup   CampusClass? @relation("ClassMembers", fields: [classGroupId], references: [id], onDelete: SetNull)
  representedClass CampusClass? @relation("ClassRepresentative")
  classMessagesSent ClassMessage[] @relation("ClassMessageSender")
  adCampaigns AdCampaign[]
  adLikes AdLike[]
  adComments AdComment[]
  engagementSessions EngagementSession[]
  sponsoredAdViews SponsoredAdView[]
  dataUsageEvents DataUsageEvent[]
  campusVideos CampusVideo[]
  campusEvents CampusEvent[]
  eventRegistrations EventRegistration[]
  globalCommunityMemberships GlobalCommunityMembership[]
  createdGlobalCommunities GlobalCommunity[]
  globalCommunityPosts GlobalCommunityPost[]
  globalCommunityMessages GlobalCommunityMessage[]
  globalStudentProfile GlobalStudentProfile?
  @@index([classGroupId])
}

model CampusClass {
  id               String   @id @default(cuid())
  name             String   @unique
  representativeId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  representative  User?    @relation("ClassRepresentative", fields: [representativeId], references: [id], onDelete: SetNull)
  members          User[]   @relation("ClassMembers")
  messages         ClassMessage[]
}

model ClassMessage {
  id        String   @id @default(cuid())
  classId   String
  senderId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  campusClass CampusClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  sender    User @relation("ClassMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([classId, createdAt])
  @@index([senderId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  category  String
  amount    Int
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model TimetableEvent {
  id          String   @id @default(cuid())
  title       String
  courseCode  String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  reminderMins Int     @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  notifications Notification[]
  recipients EventRecipient[]
  @@index([startsAt, isActive])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([published, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  eventId     String?
  title       String
  body        String
  channel     String   @default("IN_APP")
  status      String   @default("QUEUED")
  dedupeKey   String   @unique
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       TimetableEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model EventRecipient {
  id        String @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     TimetableEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([userId, eventId])
  @@index([eventId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model IdentityToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}


enum AdCampaignStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdCampaign {
  id          String           @id @default(cuid())
  advertiserId String
  businessName String
  title       String
  description String
  contact     String
  budgetTzs   Int              @default(0)
  mediaUrl    String?          @db.Text
  status      AdCampaignStatus @default(PENDING)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  advertiser  User             @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  views       SponsoredAdView[]
  likes       AdLike[]
  comments    AdComment[]
  @@index([status, createdAt])
  @@index([advertiserId, createdAt])
}


model EngagementSession {
  id              String   @id @default(cuid())
  sessionKey      String   @unique
  userId          String
  pagePath        String   @default("/")
  startedAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  endedAt         DateTime?
  durationSeconds Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
  @@index([startedAt])
}

model SponsoredAdView {
  id             String   @id @default(cuid())
  campaignId     String
  userId         String
  dayKey         String
  visibleSeconds Int      @default(0)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  campaign       AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([campaignId, userId, dayKey])
  @@index([campaignId, dayKey])
  @@index([userId, dayKey])
}


model CampusVideo {
  id          String   @id @default(cuid())
  userId      String
  publicId    String   @unique
  videoUrl    String   @db.Text
  thumbnailUrl String? @db.Text
  caption     String   @db.VarChar(500)
  category    String   @default("Campus")
  durationSeconds Int  @default(0)
  bytes       Int      @default(0)
  status      String   @default("PUBLISHED")
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}


model StudentLifeItem {
  id        String   @id @default(cuid())
  userId    String
  section   String   @db.VarChar(32)
  title     String   @db.VarChar(140)
  detail    String?  @db.VarChar(500)
  amount    Int?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, section, createdAt])
}



model PersonalSchedule {
  id           String   @id @default(cuid())
  userId       String
  kind         String   @db.VarChar(20)
  title        String   @db.VarChar(140)
  courseCode   String?  @db.VarChar(40)
  location     String?  @db.VarChar(140)
  startsAt     DateTime
  endsAt       DateTime?
  reminderMins Int      @default(15)
  repeatWeekly Boolean  @default(false)
  done         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startsAt])
  @@index([repeatWeekly, startsAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}


model AdLike {
  id         String     @id @default(cuid())
  campaignId String
  userId     String
  createdAt  DateTime   @default(now())
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([campaignId, userId])
  @@index([campaignId, createdAt])
}

model AdComment {
  id         String     @id @default(cuid())
  campaignId String
  userId     String
  body       String     @db.VarChar(1000)
  createdAt  DateTime   @default(now())
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([campaignId, createdAt])
}


model DataUsageEvent {
  id         String   @id @default(cuid())
  userId     String
  bytes      BigInt
  source     String   @default("CLIENT_ESTIMATE")
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([recordedAt])
  @@index([userId, recordedAt])
  @@index([source, recordedAt])
}

model RevenueLedgerEntry {
  id                String   @id @default(cuid())
  source            String
  description       String
  amountTzs         Int
  status            String   @default("PENDING")
  providerReference String?  @unique
  createdAt         DateTime @default(now())
  confirmedAt       DateTime?
  @@index([status, createdAt])
  @@index([source, createdAt])
}


enum CampusEventStatus {
  PENDING
  APPROVED
  REJECTED
}

model CampusEvent {
  id            String   @id @default(cuid())
  organizerId   String
  title         String   @db.VarChar(140)
  description   String   @db.VarChar(2000)
  category      String   @default("Campus") @db.VarChar(40)
  venue         String   @db.VarChar(160)
  startsAt      DateTime
  endsAt        DateTime
  organizerName String   @db.VarChar(120)
  contact       String?  @db.VarChar(120)
  status        CampusEventStatus @default(PENDING)
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organizer     User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  attendees     EventRegistration[]
  @@index([status, startsAt])
  @@index([organizerId, createdAt])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([userId, createdAt])
}


model GlobalCommunity {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  country     String   @db.VarChar(80)
  university  String?  @db.VarChar(140)
  category    String   @default("General") @db.VarChar(40)
  description String   @db.VarChar(500)
  language    String   @default("English") @db.VarChar(40)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members     GlobalCommunityMembership[]
  posts       GlobalCommunityPost[]
  messages    GlobalCommunityMessage[]
  @@index([country, category])
}

model GlobalCommunityMembership {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  role        String   @default("MEMBER") @db.VarChar(20)
  createdAt   DateTime @default(now())
  community   GlobalCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([communityId, userId])
  @@index([userId])
}


model GlobalCommunityPost {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  body        String   @db.VarChar(2000)
  createdAt   DateTime @default(now())
  community   GlobalCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([communityId, createdAt])
}

model GlobalCommunityMessage {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  body        String   @db.VarChar(2000)
  createdAt   DateTime @default(now())
  community   GlobalCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([communityId, createdAt])
}

model GlobalStudentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  country    String   @default("Not specified") @db.VarChar(80)
  bio        String   @default("") @db.VarChar(500)
  skills     String[] @default([])
  interests  String[] @default([])
  lookingFor String   @default("Study partner") @db.VarChar(80)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([country])
}
